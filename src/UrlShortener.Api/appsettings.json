{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ "
      }
    }
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "Swagger": {
    "Enabled": false
  },
  "Shortener": {
    "BaseUrl": "http://localhost:5104",
    "CodeLength": 7,
    "MaxCodeGenerationAttempts": 5,
    "MaxUrlLength": 2048,
    "MaxExpiryDays": 3650,
    "IdempotencyKeyTtlHours": 24
  },
  "RateLimiting": {
    "CreatePermitLimit": 20,
    "CreateWindowSeconds": 60,
    "RedirectPermitLimit": 600,
    "RedirectWindowSeconds": 60
  },
  "Analytics": {
    "Mode": "Async",
    "QueueCapacity": 50000,
    "MaxRecentClicksPerLink": 1000,
    "MaxDistinctValuesPerDimension": 500,
    "MaxDailyRangeDays": 366
  },
  "Cache": {
    "Enabled": true,
    "LinkTtlSeconds": 60,
    "NotFoundTtlSeconds": 5,
    "SizeLimit": 100000
  },
  "Safety": {
    "BlockedDomains": []
  },
  "Storage": {
    "SimulatedLatencyMs": 0
  },
  "ForwardedHeaders": {
    "KnownProxies": []
  }
}
