{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "IncludeScopes": true,
        "SingleLine": true
      }
    }
  },
  "Swagger": {
    "Enabled": true
  },
  "Safety": {
    "BlockedDomains": [ "malware.test", "phishing.test" ]
  }
}
