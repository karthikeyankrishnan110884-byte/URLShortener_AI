{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Shortener": {
    "BaseUrl": "http://localhost:5104",
    "CodeLength": 7,
    "MaxCodeGenerationAttempts": 5,
    "MaxUrlLength": 2048
  },
  "RateLimiting": {
    "CreatePermitLimit": 20,
    "CreateWindowSeconds": 60
  }
}
